# ─────────────────────────────────────────────────────────────────────────────
# ML Server – Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Every setting below has a sensible default in Config.py.
# Uncomment and edit any line to override without touching source code.

# ── Server ──────────────────────────────────────────────────────────────────
# APP_NAME=Your App Name
# APP_VERSION=0.1.0
# DEBUG=false

# ── NLP ─────────────────────────────────────────────────────────────────────
# TAXONOMY_NAME=esco

# ── Badges Issuer Identity ──────────────────────────────────────────────────
# ISSUER_ID=https://your-domain.com/issuers/1
# ISSUER_NAME=Your Organization Name
# ISSUER_URL=https://your-domain.com

# ── Risk Model ──────────────────────────────────────────────────────────────
# RISK_MODEL_PATH=local_models/RiskRegressor.pkl
# CALIBRATED_RISK_THRESHOLD=55.0

# ── Training Data Sources ───────────────────────────────────────────────────
# Paths are relative to the ml_server root directory (apps/ml_server/).
# Swap these to use localized ESCO files (e.g. skills_fr.csv) or different
# automation exposure datasets without changing any Python code.
# TRAINING_DATA_DIR=local_models/training_data
# SKILLS_CSV=skills_en.csv
# OCCUPATIONS_CSV=occupations_en.csv
# OCCUPATION_SKILL_RELATIONS_CSV=occupationSkillRelations_en.csv
# ILO_RISK_CSV=tableA1Data.csv
# WITTGENSTEIN_CSV=wcde_data.csv

# ── World Bank Indicator Codes (WDI) ────────────────────────────────────────
# JSON mapping of human-readable names → WDI series codes.
# Override to use different labor-market indicators for your deployment.
# WDI_INDICATOR_MAP={"indicator_key":"WDI_SERIES_CODE"}

# ── Wittgenstein Projections ────────────────────────────────────────────────
# WITTGENSTEIN_SKIP_ROWS=8
